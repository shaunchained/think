@model ArchSim.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard — Think";
}
<div class="dashboard-page">
    <div class="dashboard-header">
        <div class="dashboard-welcome">
            @if (!string.IsNullOrEmpty(Model.User.PictureUrl))
            {
                <img src="@Model.User.PictureUrl" alt="@Model.User.Name" class="dash-avatar" referrerpolicy="no-referrer" />
            }
            <div>
                <h1 class="dash-title">Welcome back, @Model.User.Name.Split(' ')[0]</h1>
                <p class="dash-sub">Here's your progress so far</p>
            </div>
        </div>
    </div>

    <div class="dash-stats">
        <div class="dash-stat-card">
            <div class="dash-stat-value">@Model.CompletedScenarios</div>
            <div class="dash-stat-label">Scenarios Completed</div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-value">@Model.TotalScenarios</div>
            <div class="dash-stat-label">Total Scenarios</div>
        </div>
        <div class="dash-stat-card">
            <div class="dash-stat-value">@Model.AveragePercentage<span class="dash-stat-unit">%</span></div>
            <div class="dash-stat-label">Average Score</div>
        </div>
        @if (Model.BestRecord != null)
        {
            var bestPct = Model.BestRecord.MaxScore > 0 ? (int)Math.Round(Model.BestRecord.TotalScore * 100.0 / Model.BestRecord.MaxScore) : 0;
            <div class="dash-stat-card">
                <div class="dash-stat-value">@bestPct<span class="dash-stat-unit">%</span></div>
                <div class="dash-stat-label">Best Score</div>
            </div>
        }
    </div>

    <div class="dash-section">
        <div class="dash-section-header">
            <h2 class="dash-section-title">Your Attempts</h2>
            <a href="/" class="btn-primary btn-sm">Browse Scenarios</a>
        </div>

        @if (!Model.ScoreRecords.Any())
        {
            <div class="dash-empty">
                <p>You haven't completed any scenarios yet.</p>
                <a href="/" class="btn-primary">Start Your First Scenario</a>
            </div>
        }
        else
        {
            <div class="dash-table-wrapper">
                <table class="dash-table">
                    <thead>
                        <tr>
                            <th>Scenario</th>
                            <th>Category</th>
                            @* <th>Difficulty</th> *@
                            <th>Score</th>
                            <th>Result</th>
                            <th>Completed</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in Model.ScoreRecords)
                        {
                            var pct = record.MaxScore > 0 ? (int)Math.Round(record.TotalScore * 100.0 / record.MaxScore) : 0;
                            <tr>
                                <td class="dash-scenario-name">@record.ScenarioTitle</td>
                                <td><span class="badge badge-cat">@record.Category</span></td>
                                @* <td><span class="badge badge-diff badge-diff-@record.Difficulty.ToLower()">@record.Difficulty</span></td> *@
                                <td>
                                    <div class="dash-score-bar">
                                        <div class="dash-score-fill" style="width:@pct%"></div>
                                    </div>
                                    <span class="dash-score-pct">@pct%</span>
                                </td>
                                <td><span class="band-badge" style="color:@record.BandColor">@record.BandLabel</span></td>
                                <td class="dash-date">@record.CompletedAt.ToString("MMM d, yyyy")</td>
                                <td>
                                    <a href="/scenario/@record.ScenarioId" class="dash-retry-btn">Retry →</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (Model.WeakAreas.Any())
    {
        <div class="dash-section">
            <div class="dash-section-header">
                <h2 class="dash-section-title">Areas to Strengthen</h2>
            </div>
            <div class="dash-summary-wrap">
                <p class="dash-summary-hint">Get a personalised analysis of your weak areas and what to study next.</p>
                <div class="dash-summary-actions">
                    <button id="btn-generate-summary" class="btn-generate-summary" onclick="generateSummary()">
                        <span id="btn-generate-summary-text">Generate Summary</span>
                        <span id="btn-generate-summary-spinner" class="summary-spinner" style="display:none">Generating…</span>
                    </button>
                    <a href="/dashboard/studyplan" class="btn-study-plan">Study Weak Areas →</a>
                </div>
                <div id="summary-result" class="summary-card" style="display:none"></div>
            </div>
        </div>
    }

    @if (Model.RecommendedScenarios.Any())
    {
        <div class="dash-section">
            <div class="dash-section-header">
                <h2 class="dash-section-title">Try Next</h2>
            </div>
            <div class="reco-grid">
                @foreach (var s in Model.RecommendedScenarios)
                {
                    <a href="/scenario/@s.Id" class="reco-card">
                        <span class="reco-card-category">@s.Category</span>
                        <div class="reco-card-title">@s.Title</div>
                        <p class="reco-card-desc">@s.Description</p>
                        <div class="reco-card-footer">
                            <span>⏱ @s.EstimatedMinutes min</span>
                            <span>@s.TotalSteps questions</span>
                            <span class="reco-card-link">Start →</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>

@if (Model.WeakAreas.Any())
{
    <script>
        async function generateSummary() {
            const btn = document.getElementById('btn-generate-summary');
            const btnText = document.getElementById('btn-generate-summary-text');
            const spinner = document.getElementById('btn-generate-summary-spinner');
            const resultBox = document.getElementById('summary-result');

            btn.disabled = true;
            btnText.style.display = 'none';
            spinner.style.display = 'inline';
            resultBox.style.display = 'none';

            try {
                const res = await fetch('/dashboard/generatesummary', { method: 'POST' });
                const data = await res.json();

                if (data.error) {
                    resultBox.innerHTML = `<span class="summary-error">${data.error}</span>`;
                } else {
                    resultBox.textContent = data.summary;
                }
                resultBox.style.display = 'block';
            } catch {
                resultBox.innerHTML = '<span class="summary-error">Something went wrong. Please try again.</span>';
                resultBox.style.display = 'block';
            }

            btn.disabled = false;
            btnText.style.display = 'inline';
            spinner.style.display = 'none';
        }
    </script>
}
