@model ArchSim.Models.ScoreViewModel
@{
    ViewData["Title"] = "Results — " + Model.Scenario.Title;
    double pct = Model.MaxScore > 0 ? (double)Model.TotalScore / Model.MaxScore : 0;
    // SVG circle math
    double radius = 54;
    double circumference = 2 * Math.PI * radius;
    double dashOffset = circumference * (1 - pct);
}

<div class="score-page">
    <div class="score-header">
        <h1 class="score-heading">Simulation Complete</h1>
        <p class="score-scenario-title">@Model.Scenario.Title</p>
    </div>

    <div class="score-circle-wrap">
        <svg class="score-svg" viewBox="0 0 120 120" width="180" height="180">
            <circle class="score-track" cx="60" cy="60" r="@radius" />
            <circle class="score-fill band-@Model.Band.Color"
                    cx="60" cy="60" r="@radius"
                    stroke-dasharray="@circumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                    stroke-dashoffset="@circumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                    data-target="@dashOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                    id="scoreFill" />
        </svg>
        <div class="score-number-wrap">
            <span class="score-number" id="scoreNumber" data-target="@Model.TotalScore">0</span>
            <span class="score-denom">/ @Model.MaxScore</span>
        </div>
    </div>

    <div class="score-band band-text-@Model.Band.Color">@Model.Band.Label</div>
    <p class="score-band-message">@Model.Band.Message</p>

    <!-- Per-step breakdown -->
    <div class="score-breakdown">
        <h2 class="breakdown-heading">Step-by-Step Breakdown</h2>
        <table class="breakdown-table">
            <thead>
                <tr>
                    <th>Step</th>
                    <th>Question</th>
                    <th>Your Answer</th>
                    <th>Score</th>
                    <th>Max</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.StepReviews)
                {
                    <tr>
                        <td class="step-num-cell">@r.StepNumber</td>
                        <td class="question-cell">@r.Question</td>
                        <td class="answer-cell">@r.SelectedOptionId. @r.SelectedOptionText</td>
                        <td class="score-cell">@r.Score</td>
                        <td class="max-cell">@r.MaxScore</td>
                        <td class="result-cell">
                            <span class="result-tag tag-color-@r.TagColor">@r.Tag</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="score-actions">
        <a href="/scenario/@Model.Scenario.Id" class="btn-outline">Try Again</a>
        <a href="/" class="btn-primary">← Back to Scenarios</a>
    </div>

    @if (Model.Scenario.Resources.Count > 0)
    {
        <div class="further-reading" style="display:none">
            <div class="further-reading-header">
                <span class="further-reading-label">Further Reading</span>
                <h2 class="further-reading-title">Go Deeper on the Key Topics</h2>
                <p class="further-reading-intro">Curated links to authoritative documentation, guides, and references for every major concept in this scenario.</p>
            </div>
            <div class="resource-groups">
                @foreach (var group in Model.Scenario.Resources)
                {
                    <div class="resource-group">
                        <h3 class="resource-group-heading">@group.Category</h3>
                        <div class="resource-links">
                            @foreach (var link in group.Items)
                            {
                                <a href="@link.Url" target="_blank" rel="noopener noreferrer" class="resource-link">
                                    <div class="resource-link-body">
                                        <span class="resource-link-label">@link.Label</span>
                                        <span class="resource-link-source">@link.Source</span>
                                    </div>
                                    <span class="resource-link-arrow">↗</span>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    @if (Model.Scenario.PostRead != null)
    {
        var pr = Model.Scenario.PostRead;
        <details class="post-read">
            <summary class="post-read-summary">
                <div class="post-read-summary-left">
                    <span class="post-read-label">Post-Read</span>
                    <span class="post-read-summary-title">@pr.Title</span>
                </div>
                <span class="post-read-chevron">▸ Expand</span>
            </summary>

            <div class="post-read-body">
                <p class="post-read-intro">@pr.Intro</p>
                <div class="post-read-sections">
                    @foreach (var sec in pr.Sections)
                    {
                        <div class="ia-section pr-section">
                            @switch (sec.Type)
                            {
                                case "text":
                                    <div class="ia-section-heading">@sec.Heading</div>
                                    <div class="ia-text-content">@sec.Content</div>
                                    break;

                                case "architecture-block":
                                    <div class="ia-section-heading">@sec.Heading</div>
                                    <div class="ia-arch-block"><pre>@sec.Content</pre></div>
                                    break;

                                case "key-principles":
                                    <div class="ia-section-heading">@sec.Heading</div>
                                    <ol class="ia-principles-list">
                                        @for (int i = 0; i < (sec.Items?.Count ?? 0); i++)
                                        {
                                            <li>
                                                <span class="principle-num">@(i + 1)</span>
                                                <span>@sec.Items![i]</span>
                                            </li>
                                        }
                                    </ol>
                                    break;

                                case "warning":
                                    <div class="ia-warning">
                                        <div class="ia-warning-heading">⚠ @sec.Heading</div>
                                        <div class="ia-warning-content">@sec.Content</div>
                                    </div>
                                    break;

                                case "tradeoffs":
                                    <div class="ia-section-heading">@sec.Heading</div>
                                    <div class="ia-tradeoffs">
                                        <div class="ia-tradeoffs-col">
                                            <div class="ia-tradeoffs-header pros">✓ Advantages</div>
                                            <ul class="ia-tradeoffs-list">
                                                @foreach (var pro in sec.Pros ?? new())
                                                {
                                                    <li><span class="trade-icon-pro">✓</span><span>@pro</span></li>
                                                }
                                            </ul>
                                        </div>
                                        <div class="ia-tradeoffs-col">
                                            <div class="ia-tradeoffs-header cons">✗ Trade-offs</div>
                                            <ul class="ia-tradeoffs-list">
                                                @foreach (var con in sec.Cons ?? new())
                                                {
                                                    <li><span class="trade-icon-con">✗</span><span>@con</span></li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                    break;
                            }
                        </div>
                    }
                </div>
            </div>
        </details>
    }
</div>

@section Scripts {
<script src="/archsim/js/scorecard.js"></script>
<script>
    window.SCORE_DATA = {
        finalScore: @Model.TotalScore,
        maxScore: @Model.MaxScore,
        dashOffset: @dashOffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture),
        circumference: @circumference.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)
    };
</script>
}
