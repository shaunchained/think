@model ArchSim.Models.Step
@{
    var scenario = (ArchSim.Models.Scenario)ViewBag.Scenario;
    int totalSteps = (int)ViewBag.TotalSteps;
    int stepNum = Model.StepNumber;
    double pct = (double)stepNum / totalSteps * 100;
    ViewData["Title"] = scenario.Title;
}

<div class="player-page">

    <!-- Progress bar -->
    <div class="progress-bar-wrap">
        <div class="progress-label">Step @stepNum of @totalSteps</div>
        <div class="progress-track">
            <div class="progress-fill" style="width: @pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
        </div>
    </div>

    <div class="player-layout">

        <!-- LEFT PANEL -->
        <div class="panel-left">

            <!-- Interviewer block -->
            <div class="interviewer-block">
                <div class="interviewer-role-label">INTERVIEWER</div>
                <div class="avatar-wrap">
                    <div class="avatar">@scenario.Interviewer.Avatar</div>
                    <div class="avatar-info">
                        <span class="interviewer-name">@scenario.Interviewer.Name</span>
                        <span class="interviewer-role">@scenario.Interviewer.Role</span>
                    </div>
                </div>
                <div class="speech-bubble">
                    @Model.InterviewerSays
                </div>
                <div class="context-hint" style="display:none">
                    💡 @Model.Context
                </div>
            </div>

            <!-- Answer options -->
            <div class="options-list" id="optionsList">
                @foreach (var opt in Model.Options)
                {
                    <button class="option-card"
                            data-id="@opt.Id"
                            data-scenario="@scenario.Id"
                            data-step="@stepNum"
                            onclick="selectAnswer(this)">
                        <span class="option-badge">@opt.Id</span>
                        <span class="option-text">@opt.Text</span>
                    </button>
                }
            </div>

            <!-- Interviewer reaction (hidden until answer selected) -->
            <div class="interviewer-reaction" id="interviewerReaction" style="display:none;">
                <span class="reaction-icon">💬</span>
                <span id="reactionText"></span>
            </div>

        </div>

        <!-- RIGHT PANEL -->
        <div class="panel-right" id="rightPanel">
            <div class="panel-right-empty" id="panelEmpty">
                <div class="lock-icon">🔒</div>
                <p>Select an answer to reveal the ideal explanation</p>
            </div>
            <div class="ideal-answer-content" id="idealContent" style="display:none;">
                <!-- Populated by JS -->
            </div>
        </div>

    </div>
</div>

@section Scripts {
<script>
    window.ARCHSIM = {
        scenarioId: '@scenario.Id',
        stepNumber: @stepNum,
        totalSteps: @totalSteps,
        isLastStep: @(stepNum >= totalSteps ? "true" : "false")
    };
</script>
}
